{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__memex__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/marker-write.mjs\""
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/edit-phonehome.mjs\""
          }
        ]
      }
    ]
  }
}
