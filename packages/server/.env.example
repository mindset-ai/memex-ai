# ============================================================
# LOCAL DEVELOPMENT ONLY
# ============================================================
# IMPORTANT: All development MUST use a local PostgreSQL instance.
# NEVER connect to the hosted/production Cloud SQL database
# during development. The production database is managed
# exclusively via deploy.sh.
#
# Start local Postgres:  brew services start postgresql@16
# Stop local Postgres:   brew services stop postgresql@16
# ============================================================

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/memex
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# spec-190 voice guide (dec-2): ElevenLabs streaming STT/TTS. The key is read
# ONLY on the server (agent/elevenlabs-client.ts) and never reaches the browser.
# Leave unset to disable voice, or set MEMEX_ELEVENLABS_FAKE=1 to use the
# deterministic test double (no key / no live audio needed).
# spec-171 t-3/t-8: Stripe billing integration (enterprise upgrade flow).
# Keys live in GCP Secret Manager in prod (std-9); set locally for testing.
# Use `stripe listen --forward-to localhost:3000/api/stripe/webhook` to get
# a local webhook secret during development.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from the Stripe dashboard — one per plan per billing cycle.
# Create these in the Stripe Products dashboard before running the upgrade flow.
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_...
STRIPE_PREMIUM_ANNUAL_PRICE_ID=price_...
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_...
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_...

# spec-171 t-4: HubSpot lead capture (self-hosted contact form → CRM).
# Private App token from HubSpot dashboard. Stored in GCP Secret Manager in prod (std-9).
HUBSPOT_API_KEY=pat-...

# spec-171 t-5: License key signing for self-hosted Enterprise (≥32 chars).
# Stored in GCP Secret Manager in prod (std-9).
LICENSE_SIGNING_SECRET=your-license-signing-secret-min-32-chars

ELEVENLABS_API_KEY=your-elevenlabs-api-key
# Optional: override the default voice. ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# Optional: override the realtime STT model (default scribe_v2_realtime).
# ELEVENLABS_STT_MODEL=scribe_v2_realtime
# Smoke-test the live key (both legs): pnpm --filter @memex/server tsx scripts/smoke-elevenlabs.ts
