# Repo-root .env — secrets SHARED across packages for local development.
# Loaded by both the server and admin vitest suites (see packages/server/vitest.setup.ts
# and packages/ui/src/test/setup.ts). Copy this file to `.env` and fill in real values:
#
#   cp .env.example .env
#
# Your `.env` is gitignored on every workstation (see .gitignore). Never commit real keys.
# In CI these are job-level env vars / secrets, NOT a committed file.

# ── AC emission (spec-129) ────────────────────────────────────────────────────
# A per-Memex emission key authorises POSTs to /api/test-events, so tests that call
# tagAc('<ns>/<memex>/specs/spec-N/acs/ac-M') verify their ACs on that Memex. Without
# a valid key, emissions are rejected 401 and silently dropped (ac-16) — tests still
# pass, but no AC verifies.
#
# Mint one in the Memex UI: open the Memex your tests' ac_uids name (e.g.
# mindset-prod/memex-building-itself) → your account menu → "Memex keys" → generate.
# Any member can mint (not just admins). A key only authorises ITS OWN Memex.
MEMEX_EMIT_KEY=

# Set MEMEX_EMIT=off to disable emission locally (default is on).
# MEMEX_EMIT=off

# ── Stripe (spec-171) ────────────────────────────────────────────────────────
# Publishable key for Stripe.js on the frontend (safe to expose in the browser).
# Get from Stripe Dashboard → Developers → API keys.
# Use the test key (pk_test_...) for local dev, live key (pk_live_...) in prod.
VITE_STRIPE_PUBLISHABLE_KEY=

# ── Local Postgres server (spec-524) ─────────────────────────────────────────
# WHERE your local Postgres lives. Set these once and every test tier follows:
# `make e2e-cold`, the server vitest suite, and the bare psql/dropdb/createdb
# calls in the Makefile all read them, because they are libpq's own variables.
#
# Leave them BLANK if your Postgres is the default localhost:5432 — blank means
# "let the driver decide", which is exactly what CI does. Set them when it is
# not: the e2e template replays migrations that need the `vector` extension, so
# the instance you point at must be pgvector-capable (Postgres 16 here), and a
# Postgres 14 on 5432 dies inside 0023_add_codebase_intelligence.sql.
#
# Check what you have:  pg_lsclusters   (or: psql -p 5433 -c 'select version()')
#
# Do NOT put these in ~/.zshrc or ~/.bashrc. Here they are scoped to this repo;
# in a login shell they would steer every psql, pg_dump and dropdb you run.
# PGHOST=localhost
# PGPORT=5433
PGPASSWORD=postgres
